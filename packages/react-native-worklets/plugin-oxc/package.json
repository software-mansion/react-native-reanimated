{
  "name": "worklets-oxc-plugin",
  "version": "0.0.0",
  "private": true,
  "main": "index.js",
  "types": "index.d.ts",
  "dependencies": {
    "@jridgewell/remapping": "2.3.5"
  },
  "files": [
    "babel.js",
    "index.js",
    "index.d.ts",
    "babel.d.ts",
    "*.node"
  ],
  "scripts": {
    "build": "cargo build --release && node scripts/post-build.mjs release",
    "build:debug": "cargo build && node scripts/post-build.mjs debug",
    "test": "yarn build:debug && cargo test && node --test \"test/**/*.test.mjs\"",
    "test:parity": "yarn build:debug && cd ../plugin && yarn run -T jest --ci --config ../plugin-oxc/jest.config.js"
  },
  "installConfig": {
    "selfReferences": false
  }
}
