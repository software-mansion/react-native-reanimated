{
  "name": "common-app",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "",
    "lint": "eslint . --flag v10_config_lookup_from_file && yarn run --top-level oxfmt --check .",
    "format": "yarn run --top-level oxfmt .",
    "circular-dependency-check": "yarn madge --extensions js,jsx,ts,tsx --circular src",
    "type:check": "yarn type:check:native && yarn type:check:web",
    "type:check:native": "tsc --noEmit",
    "type:check:web": "tsc --noEmit --project tsconfig.web.json",
    "type:check:legacy-rn-types": "tsc --noEmit --customConditions react-native-legacy-deep-imports"
  },
  "peerDependencies": {
    "react-native": "*",
    "react-native-screens": "*"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "6.5.2",
    "@fortawesome/free-regular-svg-icons": "6.5.2",
    "@fortawesome/free-solid-svg-icons": "6.5.2",
    "@fortawesome/react-native-fontawesome": "0.3.2",
    "@gorhom/bottom-sheet": "5.2.14",
    "@gorhom/portal": "1.0.14",
    "@react-native-clipboard/clipboard": "1.16.3",
    "@react-native-masked-view/masked-view": "0.3.2",
    "@react-navigation/bottom-tabs": "7.18.14",
    "@react-navigation/drawer": "7.13.5",
    "@react-navigation/native": "7.3.14",
    "@react-navigation/native-stack": "7.18.6",
    "@react-navigation/stack": "7.10.17",
    "@shopify/flash-list": "2.3.2",
    "axios": "1.19.0",
    "d3-shape": "3.2.0",
    "fuse.js": "7.5.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-native-gesture-handler": "3.1.0",
    "react-native-mmkv": "4.3.2",
    "react-native-nitro-modules": "0.36.5",
    "react-native-reanimated": "workspace:*",
    "react-native-safe-area-context": "5.8.1",
    "react-native-svg": "15.15.5",
    "react-native-worklets": "workspace:*",
    "react-strict-dom": "0.0.55"
  },
  "devDependencies": {
    "@babel/core": "7.29.6",
    "@babel/preset-env": "7.28.3",
    "@babel/runtime": "7.28.4",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native-community/cli-platform-ios": "20.2.0",
    "@react-native/babel-preset": "0.87.0",
    "@react-native/eslint-config": "0.87.0",
    "@react-native/metro-config": "0.87.0",
    "@react-native/typescript-config": "0.87.0",
    "@tsconfig/react-native": "3.0.9",
    "@types/d3-shape": "3.1.7",
    "@types/react": "19.2.18",
    "@types/react-test-renderer": "19.1.0",
    "eslint": "9.37.0",
    "madge": "8.0.0",
    "react-native": "0.87.0",
    "react-native-screens": "4.27.0",
    "react-test-renderer": "19.2.8",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.0"
  }
}
