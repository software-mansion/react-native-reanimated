{
  "name": "benchmark-app",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android --active-arch-only --mode release",
    "ios": "react-native run-ios --mode Release",
    "start": "react-native start",
    "type:check": "tsc --noEmit"
  },
  "dependencies": {
    "@react-navigation/native": "7.3.14",
    "@react-navigation/native-stack": "7.18.6",
    "react": "19.2.3",
    "react-native": "0.87.1",
    "react-native-safe-area-context": "5.8.1",
    "react-native-screens": "4.30.1"
  },
  "devDependencies": {
    "@babel/core": "7.29.6",
    "@babel/preset-env": "7.28.3",
    "@babel/runtime": "7.28.4",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native-community/cli-platform-ios": "20.2.0",
    "@react-native/babel-preset": "0.87.1",
    "@react-native/metro-config": "0.87.1",
    "@react-native/typescript-config": "0.87.1",
    "@types/react": "19.2.18",
    "typescript": "6.0.3"
  },
  "resolutions": {
    "@react-navigation/elements": "2.9.36"
  },
  "engines": {
    "node": ">= 22.11.0"
  },
  "codegenConfig": {
    "name": "NativeBenchmarkReporterSpec",
    "type": "modules",
    "jsSrcsDir": "src/specs",
    "android": {
      "javaPackageName": "com.reanimatedbenchmark"
    },
    "ios": {
      "modulesProvider": {
        "BenchmarkReporter": "RCTBenchmarkReporter"
      }
    }
  }
}
