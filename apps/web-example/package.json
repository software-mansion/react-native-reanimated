{
  "name": "web-example",
  "main": "index.js",
  "private": true,
  "version": "0.0.1",
  "scripts": {
    "start": "expo start --web",
    "start:noplugin": "DISABLE_BABEL_PLUGIN=1 yarn start",
    "production": "yarn expo export -p web && yarn serve dist --single",
    "format": "yarn run --top-level oxfmt .",
    "build": "",
    "lint": "eslint . --max-warnings 0 && yarn run --top-level oxfmt --check .",
    "type:check": "tsc --noEmit",
    "test:e2e": "node scripts/run-e2e.mjs",
    "test:e2e:ui": "node scripts/run-e2e.mjs --ui",
    "test:e2e:headed": "node scripts/run-e2e.mjs --headed"
  },
  "dependencies": {
    "common-app": "workspace:*",
    "expo": "57.0.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-native": "0.87.0",
    "react-native-screens": "4.27.0",
    "react-native-web": "0.21.2",
    "react-strict-dom": "0.0.55"
  },
  "devDependencies": {
    "@expo/metro-runtime": "57.0.8",
    "@playwright/test": "1.57.0",
    "@types/react": "19.2.18",
    "babel-preset-expo": "57.0.5",
    "eslint": "9.37.0",
    "serve": "14.2.6",
    "typescript": "5.9.3"
  },
  "installConfig": {
    "selfReferences": false
  }
}
