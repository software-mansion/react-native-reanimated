{
  "name": "ui-to-native",
  "version": "0.1.0",
  "private": true,
  "description": "Reads native data from a worklet on the UI Runtime through a TurboModule method.",
  "license": "MIT",
  "homepage": "https://docs.swmansion.com/react-native-worklets/",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./reanimated": "./src/reanimated.ts",
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": "*",
    "react-native-reanimated": "*"
  },
  "peerDependenciesMeta": {
    "react-native-reanimated": {
      "optional": true
    }
  },
  "codegenConfig": {
    "name": "PolledCounterSpec",
    "type": "modules",
    "jsSrcsDir": "src",
    "android": {
      "javaPackageName": "com.example.polledcounter"
    },
    "ios": {
      "modules": {
        "PolledCounter": {
          "className": "PolledCounter"
        }
      }
    }
  }
}
