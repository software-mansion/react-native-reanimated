import assert from 'node:assert/strict';
import { describe, it } from 'node:test';

import type { Files } from '../validate-docs-redirects.mts';
import {
  evaluateSidebars,
  findConfigRedirects,
  listRoutes,
  slugifyLabel,
  validate,
} from '../validate-docs-redirects.mts';

const AUTOGENERATED_SIDEBARS = `module.exports = { docs: [{ type: 'autogenerated', dirName: '.' }] };`;

const CONFIG = `module.exports = {
  presets: [['classic', { docs: { lastVersion: '1.0', versions: { current: { label: 'Unreleased', path: 'unreleased' } } } }]],
  plugins: [
    [
      '@docusaurus/plugin-client-redirects',
      ({
        redirects: [
          // A comment with a ] bracket.
          { from: ['/docs/old-a', '/docs/old-b'], to: '/docs/intro' },
          { from: '/docs/old-version', to: '/docs/0.9/intro' },
        ],
      }),
    ],
  ],
};`;

function site(docs: string, overrides: Record<string, string | undefined>) {
  const files: Record<string, string | undefined> = {
    'docusaurus.config.js': CONFIG,
    'versions.json': '["1.0", "0.9"]',
    'sidebars.js': AUTOGENERATED_SIDEBARS,
    'versioned_sidebars/version-1.0-sidebars.json': JSON.stringify({
      docs: [{ type: 'autogenerated', dirName: '.' }],
    }),
    'versioned_docs/version-1.0/intro.md': '# Intro',
    'versioned_docs/version-1.0/basics/_category_.json':
      '{ "label": "Basics", "link": { "type": "generated-index" } }',
    'versioned_docs/version-1.0/basics/closures.md': '# Closures',
    'docs/intro.md': '# Intro',
    'docs/concepts/_category_.json':
      '{ "label": "Concepts", "link": { "type": "generated-index" } }',
    'docs/concepts/closures.md': '# Closures',
    'pending-redirects.json': JSON.stringify([
      { from: '/docs/basics/closures', to: '/docs/concepts/closures' },
      { from: '/docs/category/basics', to: '/docs/category/concepts' },
    ]),
    ...overrides,
  };
  return Object.fromEntries(
    Object.entries(files).map(([path, content]) => [`${docs}/${path}`, content])
  );
}

function createFiles(files: Record<string, string | undefined>): Files {
  return {
    read: (path) => files[path],
    list: (dir) =>
      Object.keys(files)
        .filter(
          (path) => path.startsWith(`${dir}/`) && files[path] !== undefined
        )
        .map((path) => path.slice(dir.length + 1))
        .sort(),
  };
}

function run(overrides: Record<string, string | undefined> = {}) {
  return validate(
    createFiles({
      ...site('docs/docs-reanimated', {}),
      ...site('docs/docs-worklets', overrides),
    })
  );
}

function runAfterRelease(
  redirects: string,
  overrides: Record<string, string | undefined> = {}
) {
  return run({
    'docusaurus.config.js': CONFIG.replace(
      "lastVersion: '1.0'",
      "lastVersion: '2.0'"
    ).replace('// A comment with a ] bracket.', redirects),
    'versions.json': '["2.0", "1.0", "0.9"]',
    'versioned_sidebars/version-2.0-sidebars.json': JSON.stringify({
      docs: [{ type: 'autogenerated', dirName: '.' }],
    }),
    'versioned_docs/version-2.0/intro.md': '# Intro',
    'versioned_docs/version-2.0/concepts/_category_.json':
      '{ "label": "Concepts", "link": { "type": "generated-index" } }',
    'versioned_docs/version-2.0/concepts/closures.md': '# Closures',
    'pending-redirects.json': '[]',
    ...overrides,
  });
}

function routes(
  files: Record<string, string>,
  sidebars: Record<string, unknown> = {
    docs: [{ type: 'autogenerated', dirName: '.' }],
  }
) {
  return [...listRoutes(createFiles(files), 'content', sidebars)].sort();
}

describe('validate-docs-redirects', () => {
  describe('listRoutes', () => {
    it('derives the route of a doc from its path', () => {
      assert.deepEqual(
        routes({
          'content/intro.md': '',
          'content/guides/compatibility.mdx': '',
          'content/1-tutorials/0-concurrency-model.mdx': '',
        }),
        [
          '/docs/guides/compatibility',
          '/docs/intro',
          '/docs/tutorials/concurrency-model',
        ]
      );
    });

    it('applies the id and slug front matter', () => {
      assert.deepEqual(
        routes({
          'content/plugin/options.mdx':
            '---\nid: plugin-options # a comment\n---\n',
          'content/bundleMode/overview.mdx': "---\nslug: '/bundleMode'\n---\n",
          'content/start/start.mdx': '---\nslug: /\n---\n',
          'content/a/b.md': '---\nslug: ../c\n---\n',
          'content/a/d.md': '---\nslug: e/f\n---\n',
        }),
        [
          '/docs',
          '/docs/a/e/f',
          '/docs/bundleMode',
          '/docs/c',
          '/docs/plugin/plugin-options',
        ]
      );
    });

    it('decodes the escapes of quoted front matter values', () => {
      assert.deepEqual(
        routes({
          'content/a.md': '---\nslug: "/getting\\u002Dstarted"\n---\n',
          'content/b.md': '---\nslug: "/x\\x41\\\\y\\"z"\n---\n',
          'content/c.md': "---\nslug: '/it''s'\n---\n",
        }),
        ['/docs/getting-started', "/docs/it's", '/docs/xA\\y"z']
      );
    });

    it('serves a category index doc at the path of its directory', () => {
      assert.deepEqual(
        routes({
          'content/guides/guides.md': '',
          'content/api/index.mdx': '',
          'content/misc/README.md': '',
        }),
        ['/docs/api', '/docs/guides', '/docs/misc']
      );
    });

    it('skips drafts, partials and other files', () => {
      assert.deepEqual(
        routes({
          'content/intro.md': '',
          'content/draft.md': '---\ndraft: true\n---\n',
          'content/_partial.mdx': '',
          'content/guides/_snippets/example.md': '',
          'content/guides/example.js': '',
        }),
        ['/docs/intro']
      );
    });

    it('adds the generated index pages of autogenerated categories', () => {
      assert.deepEqual(
        routes({
          'content/basics/_category_.json':
            '{ "label": "Bundle Mode!", "link": { "type": "generated-index" } }',
          'content/basics/a.md': '',
          'content/basics/nested/_category_.json':
            '{ "link": { "type": "generated-index", "slug": "/custom" } }',
          'content/basics/nested/b.md': '',
          'content/3-numbered/_category_.json':
            '{ "link": { "type": "generated-index" } }',
          'content/3-numbered/c.md': '',
          'content/no-index/_category_.json': '{ "label": "No index" }',
          'content/no-index/d.md': '',
          'content/only-partials/_category_.json':
            '{ "label": "Partials", "link": { "type": "generated-index" } }',
          'content/only-partials/_e.md': '',
        }),
        [
          '/docs/basics/a',
          '/docs/basics/nested/b',
          '/docs/category/bundle-mode',
          '/docs/category/numbered',
          '/docs/custom',
          '/docs/no-index/d',
          '/docs/numbered/c',
        ]
      );
    });

    it('adds the generated index pages of sidebar categories', () => {
      const files = {
        'content/concepts/_category_.json':
          '{ "label": "Ignored", "link": { "type": "generated-index" } }',
        'content/concepts/closures.md': '',
        'content/concepts/deep/_category_.json':
          '{ "label": "Deep", "link": { "type": "generated-index" } }',
        'content/concepts/deep/a.md': '',
        'content/plugin/about.md': '',
      };
      assert.deepEqual(
        routes(files, {
          guides: [
            {
              type: 'category',
              label: 'Concepts',
              link: { type: 'generated-index' },
              items: [{ type: 'autogenerated', dirName: 'concepts' }],
            },
            { type: 'doc', id: 'plugin/about' },
            {
              Shorthand: [
                {
                  type: 'category',
                  label: 'Concepts',
                  link: { type: 'generated-index' },
                  items: [],
                },
              ],
            },
          ],
        }),
        [
          '/docs/category/concepts',
          '/docs/category/concepts-1',
          '/docs/category/deep',
          '/docs/concepts/closures',
          '/docs/concepts/deep/a',
          '/docs/plugin/about',
        ]
      );
    });
  });

  describe('slugifyLabel', () => {
    it('matches the category slugs of Docusaurus', () => {
      assert.equal(slugifyLabel('Bundle Mode'), 'bundle-mode');
      assert.equal(slugifyLabel('Worklets plugin'), 'worklets-plugin');
      assert.equal(slugifyLabel('C++ & JSI'), 'c--jsi');
      assert.equal(slugifyLabel('snake_case'), 'snake_case');
    });
  });

  describe('evaluateSidebars', () => {
    it('returns module.exports', () => {
      assert.deepEqual(evaluateSidebars(AUTOGENERATED_SIDEBARS), {
        docs: [{ type: 'autogenerated', dirName: '.' }],
      });
    });

    it('rejects require', () => {
      assert.throws(
        () => evaluateSidebars("module.exports = require('./other');"),
        /must not require/
      );
    });
  });

  describe('findConfigRedirects', () => {
    it('reads every from path of the client redirects plugin', () => {
      assert.deepEqual(findConfigRedirects(CONFIG), [
        { from: '/docs/old-a', to: '/docs/intro' },
        { from: '/docs/old-b', to: '/docs/intro' },
        { from: '/docs/old-version', to: '/docs/0.9/intro' },
      ]);
    });

    it('fails when the redirects of the plugin are not a literal array', () => {
      assert.throws(
        () =>
          findConfigRedirects(
            CONFIG.replace(/redirects: \[[\s\S]*?\n {8}\],/, 'redirects,')
          ),
        /must set redirects to an array literal/
      );
      assert.throws(
        () =>
          findConfigRedirects(
            "plugins: [['@docusaurus/plugin-client-redirects', { redirects: getRedirects() }]]"
          ),
        /must set redirects to an array literal/
      );
    });

    it('skips the redirects key in comments and strings', () => {
      assert.deepEqual(
        findConfigRedirects(`plugins: [['@docusaurus/plugin-client-redirects', {
  // redirects: [],
  /* redirects: [] */
  id: 'redirects: []',
  description: \`redirects: []\`,
  redirects: [{ from: '/docs/old', to: '/docs/intro' }],
}]]`),
        [{ from: '/docs/old', to: '/docs/intro' }]
      );
    });

    it('fails for an unterminated comment in the redirects', () => {
      assert.throws(
        () =>
          findConfigRedirects(
            "plugins: [['@docusaurus/plugin-client-redirects', { redirects: [ /* "
          ),
        /Found no end of the redirects list/
      );
    });

    it('returns nothing without the plugin', () => {
      assert.deepEqual(findConfigRedirects('module.exports = {};'), []);
    });
  });

  describe('validate', () => {
    it('passes when each released page has a page or a pending redirect', () => {
      const { problems, messages } = run();
      assert.deepEqual(problems, []);
      assert.equal(messages.length, 2);
      assert.match(messages[1], /each of the 3 pages of 1\.0/);
      assert.match(messages[1], /Each of the 0 pages of 0\.9/);
    });

    it('fails for a released page without a page or a redirect', () => {
      const { problems } = run({ 'pending-redirects.json': '[]' });
      assert.equal(problems.length, 2);
      assert.match(
        problems[0],
        /the 1\.0 page \/docs\/basics\/closures has no page at the same path in Unreleased.*"to" set to \/docs\/concepts\/closures\.$/
      );
      assert.match(problems[1], /\/docs\/category\/basics has no page/);
    });

    it('fails for a redirect from a page that still exists in Unreleased', () => {
      const { problems } = run({
        'pending-redirects.json': JSON.stringify([
          { from: '/docs/basics/closures', to: '/docs/concepts/closures' },
          { from: '/docs/category/basics', to: '/docs/category/concepts' },
          { from: '/docs/intro/', to: '/docs/concepts/closures' },
        ]),
      });
      assert.equal(problems.length, 1);
      assert.match(problems[0], /from \/docs\/intro\/ .* is not necessary/);
    });

    it('fails for a redirect from a path that is not a released page', () => {
      const { problems } = run({
        'pending-redirects.json': JSON.stringify([
          { from: '/docs/basics/closures', to: '/docs/concepts/closures' },
          { from: '/docs/category/basics', to: '/docs/category/concepts' },
          { from: '/docs/typo', to: '/docs/concepts/closures' },
        ]),
      });
      assert.equal(problems.length, 1);
      assert.match(problems[0], /from \/docs\/typo .* is not a page of 1\.0/);
    });

    it('fails for a redirect to a path that is not an Unreleased page', () => {
      const { problems } = run({
        'pending-redirects.json': JSON.stringify([
          { from: '/docs/basics/closures', to: '/docs/basics/closures' },
          { from: '/docs/category/basics', to: '/docs/category/concepts' },
        ]),
      });
      assert.equal(problems.length, 1);
      assert.match(
        problems[0],
        /points to a path that is not a page in Unreleased/
      );
    });

    it('fails for a repeated or already configured redirect', () => {
      const { problems } = run({
        'pending-redirects.json': JSON.stringify([
          { from: '/docs/basics/closures', to: '/docs/concepts/closures' },
          { from: '/docs/basics/closures/', to: '/docs/concepts/closures' },
          { from: '/docs/category/basics', to: '/docs/category/concepts' },
          { from: '/docs/old-a', to: '/docs/concepts/closures' },
        ]),
      });
      assert.equal(problems.length, 3);
      assert.match(problems[0], /repeats the path/);
      assert.match(
        problems[1],
        /is also in the redirects in .*docusaurus\.config\.js/
      );
      assert.match(problems[2], /from \/docs\/old-a .* is not a page of 1\.0/);
    });

    it('fails for a configured redirect to a missing page of the latest version', () => {
      const { problems } = run({
        'docusaurus.config.js': CONFIG.replace(
          "to: '/docs/intro'",
          "to: '/docs/concepts/closures'"
        ),
      });
      assert.equal(problems.length, 2);
      for (const problem of problems) {
        assert.match(
          problem,
          /docusaurus\.config\.js: the redirect from \/docs\/old-[ab] points to \/docs\/concepts\/closures, which is not a page of 1\.0/
        );
      }
    });

    it('accepts a configured redirect from a released page to a page of both versions', () => {
      const { problems } = run({
        'docusaurus.config.js': CONFIG.replace(
          '// A comment with a ] bracket.',
          "{ from: '/docs/basics/closures', to: '/docs/intro' },"
        ),
        'pending-redirects.json': JSON.stringify([
          { from: '/docs/category/basics', to: '/docs/category/concepts' },
        ]),
      });
      assert.deepEqual(problems, []);
    });

    it('fails for a configured redirect from a released page to a path that is not an Unreleased page', () => {
      const { problems } = run({
        'docusaurus.config.js': CONFIG.replace(
          '// A comment with a ] bracket.',
          "{ from: '/docs/basics/closures', to: '/docs/basics/closures' },"
        ),
        'pending-redirects.json': JSON.stringify([
          { from: '/docs/category/basics', to: '/docs/category/concepts' },
        ]),
      });
      assert.equal(problems.length, 1);
      assert.match(
        problems[0],
        /docusaurus\.config\.js: the redirect from \/docs\/basics\/closures points to \/docs\/basics\/closures, which is not a page in Unreleased/
      );
    });

    it('passes after the release moved the redirects to the config', () => {
      const { problems } = run({
        'docusaurus.config.js': CONFIG.replace(
          "lastVersion: '1.0'",
          "lastVersion: '2.0'"
        ).replace(
          '// A comment with a ] bracket.',
          "{ from: '/docs/basics/closures', to: '/docs/concepts/closures' },\n{ from: '/docs/category/basics', to: '/docs/category/concepts' },"
        ),
        'versions.json': '["2.0", "1.0", "0.9"]',
        'versioned_sidebars/version-2.0-sidebars.json': JSON.stringify({
          docs: [{ type: 'autogenerated', dirName: '.' }],
        }),
        'versioned_docs/version-2.0/intro.md': '# Intro',
        'versioned_docs/version-2.0/concepts/_category_.json':
          '{ "label": "Concepts", "link": { "type": "generated-index" } }',
        'versioned_docs/version-2.0/concepts/closures.md': '# Closures',
        'pending-redirects.json': '[]',
      });
      assert.deepEqual(problems, []);
    });

    it('keeps a pending redirect whose target is not in the new version', () => {
      const newVersion = {
        'versions.json': '["2.0", "1.0", "0.9"]',
        'versioned_sidebars/version-2.0-sidebars.json': JSON.stringify({
          docs: [{ type: 'autogenerated', dirName: '.' }],
        }),
        'versioned_docs/version-2.0/intro.md': '# Intro',
        'versioned_docs/version-2.0/basics/_category_.json':
          '{ "label": "Basics", "link": { "type": "generated-index" } }',
        'versioned_docs/version-2.0/basics/closures.md': '# Closures',
      };
      const config = CONFIG.replace("lastVersion: '1.0'", "lastVersion: '2.0'");
      const moved = run({
        ...newVersion,
        'docusaurus.config.js': config.replace(
          '// A comment with a ] bracket.',
          "{ from: '/docs/basics/closures', to: '/docs/concepts/closures' },\n{ from: '/docs/category/basics', to: '/docs/category/concepts' },"
        ),
        'pending-redirects.json': '[]',
      });
      assert.equal(moved.problems.length, 2);
      for (const problem of moved.problems) {
        assert.match(
          problem,
          /points to \/docs\/.*, which is not a page of 2\.0/
        );
      }
      const kept = run({ ...newVersion, 'docusaurus.config.js': config });
      assert.deepEqual(kept.problems, []);
    });

    it('needs a configured redirect to a page of both versions when the new version has neither end of a pending redirect', () => {
      const pending = JSON.stringify([
        { from: '/docs/basics/closures', to: '/docs/concepts/closures' },
      ]);
      const newVersion = {
        'versioned_docs/version-2.0/concepts/_category_.json': undefined,
        'versioned_docs/version-2.0/concepts/closures.md': undefined,
        'docs/concepts/_category_.json': undefined,
      };
      const kept = runAfterRelease('', {
        ...newVersion,
        'pending-redirects.json': pending,
      });
      assert.match(
        kept.problems.join('\n'),
        /from \/docs\/basics\/closures .* is not a page of 2\.0/
      );
      assert.match(
        kept.problems.join('\n'),
        /the 1\.0 page \/docs\/basics\/closures has no page/
      );
      const moved = runAfterRelease(
        "{ from: ['/docs/basics/closures', '/docs/category/basics'], to: '/docs/concepts/closures' },",
        newVersion
      );
      assert.match(
        moved.problems.join('\n'),
        /points to \/docs\/concepts\/closures, which is not a page of 2\.0/
      );
      const redirectedToBoth = runAfterRelease(
        "{ from: ['/docs/basics/closures', '/docs/category/basics'], to: '/docs/intro' },",
        newVersion
      );
      assert.deepEqual(redirectedToBoth.problems, []);
    });

    it('fails when the release emptied the pending redirects without moving them to the config', () => {
      const { problems } = runAfterRelease('');
      assert.equal(problems.length, 2);
      assert.match(
        problems[0],
        /the 1\.0 page \/docs\/basics\/closures has no page at the same path in 2\.0 and no redirect in .*docusaurus\.config\.js\..*"to" set to \/docs\/concepts\/closures\./
      );
      assert.match(
        problems[1],
        /the 1\.0 page \/docs\/category\/basics has no page at the same path in 2\.0/
      );
    });

    it('does not accept a pending redirect for a page of the previous version', () => {
      const { problems } = runAfterRelease('', {
        'pending-redirects.json': JSON.stringify([
          { from: '/docs/basics/closures', to: '/docs/concepts/closures' },
          { from: '/docs/category/basics', to: '/docs/category/concepts' },
        ]),
      });
      assert.equal(problems.length, 4);
      assert.match(
        problems[0],
        /from \/docs\/basics\/closures .* is not a page of 2\.0/
      );
      assert.match(
        problems[1],
        /from \/docs\/category\/basics .* is not a page of 2\.0/
      );
      assert.match(
        problems[2],
        /the 1\.0 page \/docs\/basics\/closures has no page/
      );
      assert.match(
        problems[3],
        /the 1\.0 page \/docs\/category\/basics has no page/
      );
    });

    it('accepts a configured redirect to a section of a page of the latest version', () => {
      const { problems } = runAfterRelease(
        "{ from: ['/docs/basics/closures', '/docs/category/basics/'], to: '/docs/concepts/closures#closures' },"
      );
      assert.deepEqual(problems, []);
    });

    it('fails for a configured redirect from a page of the previous version to a page of an older version', () => {
      const { problems } = runAfterRelease(
        "{ from: '/docs/basics/closures', to: '/docs/1.0/basics/closures' },\n{ from: '/docs/category/basics', to: 'https://example.com' },"
      );
      assert.equal(problems.length, 2);
      assert.match(
        problems[0],
        /docusaurus\.config\.js: the redirect from \/docs\/basics\/closures points to \/docs\/1\.0\/basics\/closures, which is not a page of 2\.0/
      );
      assert.match(
        problems[1],
        /the redirect from \/docs\/category\/basics points to https:\/\/example\.com, which is not a page of 2\.0/
      );
    });

    it('reports a configured redirect from a page of the previous version to a missing page of the latest version once', () => {
      const { problems } = runAfterRelease(
        "{ from: '/docs/basics/closures', to: '/docs/basics/closures' },\n{ from: '/docs/category/basics', to: '/docs/category/concepts' },"
      );
      assert.equal(problems.length, 1);
      assert.match(
        problems[0],
        /the redirect from \/docs\/basics\/closures points to \/docs\/basics\/closures, which is not a page of 2\.0/
      );
    });

    it('skips the check of the previous version when there is none', () => {
      const { problems, messages } = run({
        'docusaurus.config.js': CONFIG.replace(
          "{ from: '/docs/old-version', to: '/docs/0.9/intro' },",
          ''
        ),
        'versions.json': '["1.0"]',
      });
      assert.deepEqual(problems, []);
      assert.doesNotMatch(messages[1], /pages of 0\.9/);
    });

    it('fails when the pending redirects file has a wrong shape', () => {
      assert.throws(
        () => run({ 'pending-redirects.json': '{ "from": "/docs/a" }' }),
        /must hold an array/
      );
    });

    it('fails when the pending redirects file is missing', () => {
      assert.throws(
        () => run({ 'pending-redirects.json': undefined }),
        /pending-redirects\.json does not exist/
      );
    });

    it('skips a site without a released version', () => {
      const { problems, messages } = run({
        'docusaurus.config.js': "lastVersion: 'current',",
      });
      assert.deepEqual(problems, []);
      assert.match(messages[1], /has no released docs version/);
    });
  });
});
