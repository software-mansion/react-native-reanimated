+WorkerRuntimeTarget::WorkerRuntimeTarget(
+    std::string targetId,
+    WorkerRuntimeDescription description,
+    std::shared_ptr<RuntimeTarget> runtimeTarget)
+    : targetId_(std::move(targetId)),
+      description_(std::move(description)),
