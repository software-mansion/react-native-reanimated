+  return *runtimeTarget_;
+}
+
+WorkerRuntimeTarget& HostTarget::registerWorkerRuntime(
+    WorkerRuntimeDescription description,
+    RuntimeTargetDelegate& delegate,
+    RuntimeExecutor jsExecutor) {
+  auto targetId = "worker-" + std::to_string(nextWorkerRuntimeId_++);
+  auto runtimeTarget = RuntimeTarget::create(
+      ExecutionContextDescription{
+          .id = executionContextManager_->allocateExecutionContextId(),
+          .origin = "",
+          .name = description.title,
+          .uniqueId = std::nullopt},
+      delegate,
+      std::move(jsExecutor),
+      makeVoidExecutor(executorFromThis()));
+  std::unique_ptr<WorkerRuntimeTarget> worker(new WorkerRuntimeTarget(
+      std::move(targetId), std::move(description), std::move(runtimeTarget)));
+  auto& workerRef = *worker;
+  workerRuntimes_.push_back(std::move(worker));
+  sessions_.forEach([&workerRef](HostTargetSession& session) {
+    session.targetAgent().onWorkerRuntimeAdded(workerRef);
+  });
+  return workerRef;
+}
+
+void HostTarget::unregisterWorkerRuntime(WorkerRuntimeTarget& worker) {
+  sessions_.forEach([&worker](HostTargetSession& session) {
+    session.targetAgent().onWorkerRuntimeRemoved(worker);
+  });
+  for (auto it = workerRuntimes_.begin(); it != workerRuntimes_.end(); ++it) {
+    if (it->get() == &worker) {
+      workerRuntimes_.erase(it);
+      return;
+    }
+  }
+  assert(false && "Invalid worker runtime unregistration");
+}
