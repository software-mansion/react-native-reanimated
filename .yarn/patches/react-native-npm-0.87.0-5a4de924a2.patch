@@ -0,0 +1,58 @@
+/*
+ * Copyright (c) Meta Platforms, Inc. and affiliates.
+ *
+ * This source code is licensed under the MIT license found in the
+ * LICENSE file in the root directory of this source tree.
+ */
+
+package com.facebook.react.devsupport.inspector
+
+import android.os.Handler
+import android.os.HandlerThread
+import android.os.Looper
+import java.util.concurrent.CountDownLatch
+import java.util.concurrent.Executor
+
+/**
+ * The thread on which the modern inspector (React Native DevTools) dispatches its work: inspector
+ * messages from the dev server, HostTarget callbacks and session lifecycle. It is deliberately not
+ * the UI thread, so that a JS runtime paused on the UI thread can still be resumed.
+ */
+public object InspectorThread {
+  private val handlerThread: HandlerThread by lazy {
+    HandlerThread("ReactNativeInspector").apply { start() }
+  }
+
+  public val handler: Handler by lazy { Handler(handlerThread.looper) }
+
+  /** Runs commands on the inspector thread, immediately when already on it. */
+  public val executor: Executor = Executor { command ->
+    if (isOnInspectorThread()) {
+      command.run()
+    } else {
+      handler.post(command)
+    }
+  }
+
+  public fun isOnInspectorThread(): Boolean = Looper.myLooper() == handlerThread.looper
+
+  /**
+   * Runs the block on the inspector thread and waits for it to complete. Do not call from code
+   * that the inspector thread itself may be waiting on.
+   */
+  public fun runSync(block: () -> Unit) {
+    if (isOnInspectorThread()) {
+      block()
+      return
+    }
+    val latch = CountDownLatch(1)
+    handler.post {
+      try {
+        block()
+      } finally {
+        latch.countDown()
+      }
+    }
+    latch.await()
+  }
+}
