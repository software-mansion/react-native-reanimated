+/*
+ * Copyright (c) Meta Platforms, Inc. and affiliates.
+ *
+ * This source code is licensed under the MIT license found in the
+ * LICENSE file in the root directory of this source tree.
+ */
+
+#import <Foundation/Foundation.h>
+#import <React/RCTDefines.h>
+
+/**
+ * The serial queue on which the modern inspector (React Native DevTools)
+ * dispatches its work: inspector messages from the dev server, HostTarget
+ * callbacks and session lifecycle. It is deliberately not the main queue, so
+ * that a JS runtime paused on the main thread can still be resumed.
+ */
+RCT_EXTERN dispatch_queue_t RCTInspectorQueue(void);
+
+/**
+ * Whether the current thread is running on the inspector queue.
+ */
+RCT_EXTERN BOOL RCTIsOnInspectorQueue(void);
+
+/**
+ * Runs the block on the inspector queue: immediately when already on it,
+ * asynchronously otherwise.
+ */
+RCT_EXTERN void RCTExecuteOnInspectorQueue(dispatch_block_t block);
+
+/**
+ * Runs the block on the inspector queue and waits for it to complete. Do not
+ * call from code that the inspector queue itself may be waiting on.
+ */
+RCT_EXTERN void RCTUnsafeExecuteOnInspectorQueueSync(dispatch_block_t block);
diff --git a/React/Inspector/RCTInspectorQueue.mm b/React/Inspector/RCTInspectorQueue.mm
new file mode 100644
index 0000000000000000000000000000000000000000..3da3e3de7c31b3e53a81347136f8af746e19eba0
--- /dev/null
+++ b/React/Inspector/RCTInspectorQueue.mm
@@ -0,0 +1,47 @@
+/*
+ * Copyright (c) Meta Platforms, Inc. and affiliates.
+ *
+ * This source code is licensed under the MIT license found in the
+ * LICENSE file in the root directory of this source tree.
+ */
+
+#import "RCTInspectorQueue.h"
+
+static void *const RCTInspectorQueueKey = (void *)&RCTInspectorQueueKey;
+
+dispatch_queue_t RCTInspectorQueue(void)
+{
+  static dispatch_queue_t queue;
+  static dispatch_once_t onceToken;
+  dispatch_once(&onceToken, ^{
+    dispatch_queue_attr_t attributes =
+        dispatch_queue_attr_make_with_qos_class(DISPATCH_QUEUE_SERIAL, QOS_CLASS_USER_INITIATED, 0);
+    queue = dispatch_queue_create("com.facebook.react.inspector", attributes);
+    dispatch_queue_set_specific(queue, RCTInspectorQueueKey, RCTInspectorQueueKey, NULL);
+  });
+  return queue;
+}
+
+BOOL RCTIsOnInspectorQueue(void)
+{
+  RCTInspectorQueue();
+  return dispatch_get_specific(RCTInspectorQueueKey) == RCTInspectorQueueKey;
+}
+
+void RCTExecuteOnInspectorQueue(dispatch_block_t block)
+{
+  if (RCTIsOnInspectorQueue()) {
+    block();
+  } else {
+    dispatch_async(RCTInspectorQueue(), block);
+  }
+}
+
+void RCTUnsafeExecuteOnInspectorQueueSync(dispatch_block_t block)
+{
+  if (RCTIsOnInspectorQueue()) {
+    block();
+  } else {
+    dispatch_sync(RCTInspectorQueue(), block);
+  }
+}
