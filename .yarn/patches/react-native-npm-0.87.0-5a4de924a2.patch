index 0000000000000000000000000000000000000000..989d58e9c796500bdeb921fb52a252ee056b97b5
--- /dev/null
+++ b/ReactCommon/jsinspector-modern/TargetAgent.cpp
@@ -0,0 +1,296 @@
+/*
+ * Copyright (c) Meta Platforms, Inc. and affiliates.
+ *
+ * This source code is licensed under the MIT license found in the
+ * LICENSE file in the root directory of this source tree.
+ */
+
+#include "TargetAgent.h"
+#include "HostTarget.h"
+
+#include <folly/dynamic.h>
+#include <folly/json.h>
+
+#include <utility>
+#include <vector>
+
+namespace facebook::react::jsinspector_modern {
+
+namespace {
+
+/**
+ * Inserts a `sessionId` property into a JSON-encoded CDP message, which is
+ * how a flattened child session is addressed on the wire.
+ */
+std::string withSessionId(std::string_view message, const std::string& sessionId) {
+  std::string prefix = "{\"sessionId\":\"" + sessionId + "\"";
+  if (message.size() < 2 || message.front() != '{') {
+    return std::string(message);
+  }
+  if (message.size() == 2) {
+    return prefix + "}";
+  }
+  return prefix + "," + std::string(message.substr(1));
+}
+
+bool boolParam(const folly::dynamic& params, const char* name) {
+  if (!params.isObject()) {
+    return false;
+  }
+  const auto* value = params.get_ptr(name);
+  return value != nullptr && value->isBool() && value->getBool();
+}
+
+std::optional<std::string> stringParam(
+    const folly::dynamic& params,
+    const char* name) {
+  if (!params.isObject()) {
+    return std::nullopt;
+  }
+  const auto* value = params.get_ptr(name);
+  if (value == nullptr || !value->isString()) {
+    return std::nullopt;
+  }
+  return value->getString();
+}
+
+} // namespace
+
+TargetAgent::TargetAgent(
+    FrontendChannel frontendChannel,
+    HostTargetController& targetController)
+    : frontendChannel_(std::move(frontendChannel)),
+      targetController_(targetController) {}
+
+TargetAgent::~TargetAgent() = default;
+
+bool TargetAgent::handleRequest(const cdp::PreparsedRequest& req) {
+  if (req.method == "Target.setAutoAttach") {
+    autoAttach_ = boolParam(req.params, "autoAttach");
+    if (autoAttach_) {
+      for (auto* worker : targetController_.getWorkerRuntimes()) {
+        if (!findSessionByTargetId(worker->getTargetId())) {
+          attach(*worker);
+        }
+      }
+    }
+    frontendChannel_(cdp::jsonResult(req.id));
+    return true;
+  }
+  if (req.method == "Target.setDiscoverTargets") {
+    discoverTargets_ = boolParam(req.params, "discover");
+    if (discoverTargets_) {
+      for (auto* worker : targetController_.getWorkerRuntimes()) {
+        frontendChannel_(
+            cdp::jsonNotification(
+                "Target.targetCreated",
+                folly::dynamic::object("targetInfo", targetInfo(*worker))));
+      }
+    }
+    frontendChannel_(cdp::jsonResult(req.id));
+    return true;
+  }
+  if (req.method == "Target.getTargets") {
+    folly::dynamic targetInfos = folly::dynamic::array();
+    for (auto* worker : targetController_.getWorkerRuntimes()) {
+      targetInfos.push_back(targetInfo(*worker));
+    }
+    frontendChannel_(
+        cdp::jsonResult(
+            req.id, folly::dynamic::object("targetInfos", std::move(targetInfos))));
+    return true;
+  }
+  if (req.method == "Target.attachToTarget") {
+    auto targetId = stringParam(req.params, "targetId");
+    WorkerRuntimeTarget* worker = nullptr;
+    if (targetId) {
+      for (auto* candidate : targetController_.getWorkerRuntimes()) {
+        if (candidate->getTargetId() == *targetId) {
+          worker = candidate;
+          break;
+        }
+      }
+    }
+    if (worker == nullptr) {
+      frontendChannel_(
+          cdp::jsonError(
+              req.id,
+              cdp::ErrorCode::InvalidParams,
+              "No target with given id found"));
+      return true;
+    }
+    if (auto existing = findSessionByTargetId(worker->getTargetId())) {
+      frontendChannel_(
+          cdp::jsonResult(
+              req.id, folly::dynamic::object("sessionId", *existing)));
+      return true;
+    }
+    auto sessionId = attach(*worker);
+    if (!sessionId) {
+      frontendChannel_(
+          cdp::jsonError(
+              req.id,
+              cdp::ErrorCode::InternalError,
+              "Target rejected the connection"));
+      return true;
+    }
+    frontendChannel_(
+        cdp::jsonResult(
+            req.id, folly::dynamic::object("sessionId", *sessionId)));
+    return true;
+  }
+  if (req.method == "Target.detachFromTarget") {
+    auto sessionId = stringParam(req.params, "sessionId");
+    if (!sessionId || sessions_.find(*sessionId) == sessions_.end()) {
+      frontendChannel_(
+          cdp::jsonError(
+              req.id, cdp::ErrorCode::InvalidParams, "No session with given id"));
+      return true;
+    }
+    detach(*sessionId);
+    frontendChannel_(cdp::jsonResult(req.id));
+    return true;
+  }
+  if (req.method == "Target.setRemoteLocations" ||
+      req.method == "Target.activateTarget") {
+    frontendChannel_(cdp::jsonResult(req.id));
+    return true;
+  }
+  return false;
+}
+
+void TargetAgent::handleChildRequest(const cdp::PreparsedRequest& req) {
+  assert(req.sessionId.has_value() && "Child requests carry a sessionId");
+  auto sessionIt = sessions_.find(*req.sessionId);
+  if (sessionIt == sessions_.end()) {
+    frontendChannel_(
+        withSessionId(
+            cdp::jsonError(
+                req.id, cdp::ErrorCode::InvalidRequest, "Session not found"),
+            *req.sessionId));
+    return;
+  }
+  auto& session = *sessionIt->second;
+  if (req.method == "Runtime.enable") {
+    sendChildExecutionContextCreated(session);
+  }
+  if (req.method == "ReactNativeApplication.enable" ||
+      req.method == "ReactNativeApplication.disable") {
+    // The application-level domain is served by the main session only.
+    session.channel(cdp::jsonResult(req.id));
+    return;
+  }
+  cdp::PreparsedRequest childRequest = req;
+  childRequest.sessionId.reset();
+  try {
+    if (session.agent->handleRequest(childRequest)) {
+      return;
+    }
+  } catch (const cdp::TypeError& e) {
+    session.channel(
+        cdp::jsonError(req.id, cdp::ErrorCode::InvalidRequest, e.what()));
+    return;
+  }
+  session.channel(
+      cdp::jsonError(req.id, cdp::ErrorCode::MethodNotFound, req.method));
+}
+
+void TargetAgent::onWorkerRuntimeAdded(WorkerRuntimeTarget& worker) {
+  if (discoverTargets_) {
+    frontendChannel_(
+        cdp::jsonNotification(
+            "Target.targetCreated",
+            folly::dynamic::object("targetInfo", targetInfo(worker))));
+  }
+  if (autoAttach_) {
+    attach(worker);
+  }
+}
+
+void TargetAgent::onWorkerRuntimeRemoved(WorkerRuntimeTarget& worker) {
+  if (auto sessionId = findSessionByTargetId(worker.getTargetId())) {
+    detach(*sessionId);
+  } else if (discoverTargets_) {
+    frontendChannel_(
+        cdp::jsonNotification(
+            "Target.targetDestroyed",
+            folly::dynamic::object("targetId", worker.getTargetId())));
+  }
+}
+
+std::optional<std::string> TargetAgent::attach(WorkerRuntimeTarget& worker) {
+  auto sessionId = "worker-" + std::to_string(nextSessionId_++);
+  auto session = std::make_unique<ChildSession>();
+  session->targetId = worker.getTargetId();
+  session->channel = [frontendChannel = frontendChannel_,
+                      sessionId](std::string_view message) {
+    frontendChannel(withSessionId(message, sessionId));
+  };
+  session->agent =
+      worker.getRuntimeTarget().createAgent(session->channel, session->state);
+  if (!session->agent) {
+    return std::nullopt;
+  }
+  frontendChannel_(
+      cdp::jsonNotification(
+          "Target.attachedToTarget",
+          folly::dynamic::object("sessionId", sessionId)(
+              "targetInfo", targetInfo(worker))("waitingForDebugger", false)));
+  sessions_.emplace(sessionId, std::move(session));
+  return sessionId;
+}
+
+void TargetAgent::detach(const std::string& sessionId) {
+  auto sessionIt = sessions_.find(sessionId);
+  if (sessionIt == sessions_.end()) {
+    return;
+  }
+  auto session = std::move(sessionIt->second);
+  sessions_.erase(sessionIt);
+  auto targetId = session->targetId;
+  session.reset();
+  frontendChannel_(
+      cdp::jsonNotification(
+          "Target.detachedFromTarget",
+          folly::dynamic::object("sessionId", sessionId)("targetId", targetId)));
+  if (discoverTargets_) {
+    frontendChannel_(
+        cdp::jsonNotification(
+            "Target.targetDestroyed",
+            folly::dynamic::object("targetId", targetId)));
+  }
+}
+
+std::optional<std::string> TargetAgent::findSessionByTargetId(
+    const std::string& targetId) const {
+  for (const auto& [sessionId, session] : sessions_) {
+    if (session->targetId == targetId) {
+      return sessionId;
+    }
+  }
+  return std::nullopt;
+}
+
+folly::dynamic TargetAgent::targetInfo(WorkerRuntimeTarget& worker) const {
+  const auto& description = worker.getDescription();
+  return folly::dynamic::object("targetId", worker.getTargetId())(
+      "type", "worker")("title", description.title)("url", description.url)(
+      "attached", findSessionByTargetId(worker.getTargetId()).has_value())(
+      "canAccessOpener", false);
+}
+
+void TargetAgent::sendChildExecutionContextCreated(
+    const ChildSession& session) {
+  const auto& context = session.agent->getExecutionContextDescription();
+  folly::dynamic params = folly::dynamic::object(
+      "context",
+      folly::dynamic::object("id", context.id)("origin", context.origin)(
+          "name", context.name));
+  if (context.uniqueId.has_value()) {
+    params["context"]["uniqueId"] = *context.uniqueId;
+  }
+  session.channel(
+      cdp::jsonNotification("Runtime.executionContextCreated", params));
+}
+
+} // namespace facebook::react::jsinspector_modern
