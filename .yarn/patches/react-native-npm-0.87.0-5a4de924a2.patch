+#include <optional>
+#include <string>
+
+namespace facebook::react::jsinspector_modern {
+
+class HostTargetController;
+class WorkerRuntimeTarget;
+
+/**
+ * Implements the CDP Target domain for a HostTarget session. Exposes the
+ * host's worker runtimes (see HostTarget::registerWorkerRuntime) to the
+ * frontend as "worker" targets, the way browsers expose Web Workers, and
+ * multiplexes the child sessions the frontend attaches to them: every message
+ * of a child session carries the session's `sessionId`.
+ */
+class TargetAgent final {
+ public:
+  /**
+   * \param frontendChannel A channel used to send responses and events to the
+   * frontend.
+   * \param targetController An interface to the HostTarget that this agent is
+   * attached to. The caller is responsible for ensuring that the HostTarget
+   * outlives the agent.
+   */
+  TargetAgent(FrontendChannel frontendChannel, HostTargetController &targetController);
+
+  TargetAgent(const TargetAgent &) = delete;
+  TargetAgent(TargetAgent &&) = delete;
+  TargetAgent &operator=(const TargetAgent &) = delete;
+  TargetAgent &operator=(TargetAgent &&) = delete;
+
+  ~TargetAgent();
+
+  /**
+   * Handle a CDP request of the Target domain. The response will be sent over
+   * the provided \c FrontendChannel synchronously.
+   * \returns true if this agent has responded to the request.
+   */
+  bool handleRequest(const cdp::PreparsedRequest &req);
+
+  /**
+   * Handle a CDP request addressed to a child session (a request carrying a
+   * `sessionId`). Always responds, with an error if the session is unknown.
+   */
+  void handleChildRequest(const cdp::PreparsedRequest &req);
+
+  /**
+   * Notifies the frontend about a newly registered worker runtime and attaches
+   * to it if the frontend requested auto-attachment.
+   */
+  void onWorkerRuntimeAdded(WorkerRuntimeTarget &worker);
+
+  /**
+   * Detaches from the worker runtime, if attached, and notifies the frontend.
+   * Must be called before the worker's RuntimeTarget is destroyed.
+   */
+  void onWorkerRuntimeRemoved(WorkerRuntimeTarget &worker);
+
+ private:
+  struct ChildSession {
+    std::string targetId;
+    FrontendChannel channel;
+    SessionState state;
+    std::shared_ptr<RuntimeAgent> agent;
+  };
+
+  std::optional<std::string> attach(WorkerRuntimeTarget &worker);
+  void detach(const std::string &sessionId);
+  std::optional<std::string> findSessionByTargetId(const std::string &targetId) const;
+  folly::dynamic targetInfo(WorkerRuntimeTarget &worker) const;
+  void sendChildExecutionContextCreated(const ChildSession &session);
+
+  FrontendChannel frontendChannel_;
+  HostTargetController &targetController_;
+  bool autoAttach_{false};
+  bool discoverTargets_{false};
+  uint64_t nextSessionId_{1};
+  std::map<std::string, std::unique_ptr<ChildSession>> sessions_;
+};
+
+} // namespace facebook::react::jsinspector_modern
